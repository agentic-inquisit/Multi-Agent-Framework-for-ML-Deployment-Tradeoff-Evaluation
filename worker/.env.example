# Required — all 6 agents run on ChatAnthropic; Agents 1-4 (landscape,
# benchmark, infra-constraint, cost-modeling) also use Anthropic's native
# web_search tool, so no separate search-provider key is needed.
ANTHROPIC_API_KEY=

# Prod checkpointer (langgraph-checkpoint-postgres). Leave blank for local
# dev — src/checkpoint.py falls back to a SQLite file checkpointer.
DATABASE_URL=

# Optional — LangSmith tracing (per-agent cost/latency/failure visibility).
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ml-tradeoff-eval-dev
